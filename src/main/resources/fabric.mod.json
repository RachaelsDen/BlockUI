{
  "schemaVersion": 1,
  "id": "blockui",
  "version": "${version}",
  "name": "UI Library Mod",
  "description": "UI Library mod, use ctrl+alt+shift+x to open a test-ui",
  "authors": [
    "LDT Team"
  ],
  "contact": {
    "homepage": "https://github.com/ldtteam/BlockUI",
    "sources": "https://github.com/ldtteam/BlockUI.git",
    "issues": "https://github.com/ldtteam/BlockUI/issues/new/choose"
  },
  "license": "GPL3",
  "icon": "assets/blockui/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ldtteam.blockui.mod.BlockUI"
    ],
    "client": [
      "com.ldtteam.blockui.mod.BlockUIClient"
    ]
  },
  "mixins": [
    "blockui.mixins.json"
  ],
  "accessWidener": "blockui.accessWidener",
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.116.12",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "cloth-config": ">=15.0.140"
  },
  "recommends": {
    "modmenu": "*"
  }
}
